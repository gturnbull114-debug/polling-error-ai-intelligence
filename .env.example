# ==============================================================================
# Environment Configuration Template
# Project: AI Polling Intelligence Agentic System
# Course: LIAI 1001 - Strategy and Change (Georgian College)
# Student: Graham Turnbull (200679442)
# ==============================================================================
# NOTE: Copy this file to '.env' and fill in real values.
# NEVER commit the actual '.env' file containing real secrets to version control.
# ==============================================================================

# Application Environment (development | staging | production)
APP_ENV=development
DEBUG=True
LOG_LEVEL=INFO

# LLM & AI Provider Settings (Optional: leave mock mode enabled for local tests)
LLM_PROVIDER=mock
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Real-Time Web Search Configuration for PollBot (SerpApi)
SERPAPI_API_KEY=your_serpapi_key_here

# Polling Data Ingestion Sources
POLL_DATA_SOURCE=mock
POLL_API_ENDPOINT=https://api.example.org/polls/v1
POLL_API_KEY=your_poll_api_key_here

# Agent Execution & Safety Guardrails
MAX_ITERATIONS=10
TEMPERATURE=0.2
REQUIRE_HUMAN_APPROVAL_ON_OUTLIER=True
OUTLIER_THRESHOLD_PERCENT=3.5
MAX_EXECUTION_TIMEOUT_SECONDS=60

# Output & Evidence Logging
LOG_DIR=./logs
EVIDENCE_DIR=./evidence
DATA_DIR=./data
